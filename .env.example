# Local or Oracle/osoance runtime settings.
# The Oracle host's add-app.sh writes the production values automatically.
PORT=47831
SCOUT_OPEN=1
SCOUT_HOSTS=127.0.0.1,localhost

# Shared Pi installation. Do not copy auth.json or provider keys into this repo.
PI_AGENT_DIR=/var/lib/pi/agent
PI_CODING_AGENT_PACKAGE=/usr/local/lib/node_modules/@earendil-works/pi-coding-agent
